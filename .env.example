# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — GMX GAMING
# ==============================================================================
# Copia este archivo como .env.local para desarrollo local:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Supabase (Base de datos y Autenticación)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_publishable_key
SUPABASE_ANON_KEY=tu_anon_key

# ------------------------------------------------------------------------------
# 2. URL del Sitio (Segun el entorno)
# ------------------------------------------------------------------------------
# • Para desarrollo local con npm run dev:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# • Para entorno de Development / Staging en Vercel:
NEXT_PUBLIC_SITE_URL=https://gmxgaming.vercel.app

# • Para entorno de Producción final en Vercel (Configurar en Project Settings > Environment Variables):
# NEXT_PUBLIC_SITE_URL=https://gmxgaming.com
